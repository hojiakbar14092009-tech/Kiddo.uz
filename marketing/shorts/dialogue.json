{
  "water": {
    "voice": true,
    "lines": [
      {
        "who": "mini",
        "scene": "hook",
        "uz": "Piku, yomg‘ir qayerdan keladi?",
        "ru": "Пику, откуда берётся дождь?",
        "en": "Piku, where does rain come from?"
      },
      {
        "who": "piku",
        "scene": "ask",
        "uz": "Keling, birga bilib olamiz!",
        "ru": "Давай узнаем вместе!",
        "en": "Let’s find out together!"
      },
      {
        "who": "mini",
        "scene": "sun",
        "uz": "Avval quyosh dengizni isitadi.",
        "ru": "Сначала солнце греет море.",
        "en": "First, the sun warms the sea."
      },
      {
        "who": "piku",
        "scene": "steam",
        "uz": "Suv iliq bo‘lib, bug‘ga aylanadi.",
        "ru": "Вода теплеет и становится паром.",
        "en": "The water gets warm and turns into steam."
      },
      {
        "who": "mini",
        "scene": "invisible",
        "uz": "Bug‘ ko‘rinmaydi, lekin yuqoriga uchadi.",
        "ru": "Пар не виден, но летит вверх.",
        "en": "Steam is invisible, but it flies up."
      },
      {
        "who": "piku",
        "scene": "rise",
        "uz": "Kichkina tomchilar osmonga ko‘tariladi.",
        "ru": "Крошечные капельки поднимаются в небо.",
        "en": "Tiny droplets rise up to the sky."
      },
      {
        "who": "mini",
        "scene": "gather",
        "uz": "U yerda sovuq. Tomchilar yig‘iladi.",
        "ru": "Там холодно. Капельки собираются вместе.",
        "en": "It is cold up there. The droplets gather."
      },
      {
        "who": "piku",
        "scene": "cloud",
        "uz": "Ular birlashib, bulut bo‘ladi!",
        "ru": "Они соединяются и становятся облаком!",
        "en": "Together they make a cloud!"
      },
      {
        "who": "mini",
        "scene": "heavy",
        "uz": "Bulut og‘irlashadi. Tomchilar tushadi.",
        "ru": "Облако тяжелеет. Капельки падают.",
        "en": "The cloud gets heavy. Drops fall down."
      },
      {
        "who": "piku",
        "scene": "rain",
        "uz": "Mana yomg‘ir! Gullar suv ichadi.",
        "ru": "Вот и дождь! Цветы пьют воду.",
        "en": "Here is the rain! The flowers drink."
      },
      {
        "who": "mini",
        "scene": "mean",
        "uz": "Demak, yomg‘ir — bulutdagi suv!",
        "ru": "Значит, дождь — это вода из облака!",
        "en": "So rain is water from the cloud!"
      },
      {
        "who": "piku",
        "scene": "river",
        "uz": "Suv oqib, daryoga tushadi.",
        "ru": "Вода стекает в реку.",
        "en": "The water runs into the river."
      },
      {
        "who": "mini",
        "scene": "sea",
        "uz": "Daryo suvni yana dengizga olib boradi.",
        "ru": "Река несёт воду обратно в море.",
        "en": "The river carries it back to the sea."
      },
      {
        "who": "piku",
        "scene": "cycle",
        "uz": "Dengiz, bulut, yomg‘ir — suv aylanadi!",
        "ru": "Море, облако, дождь — вода кружит!",
        "en": "Sea, cloud, rain — the water goes round!"
      },
      {
        "who": "mini",
        "scene": "never",
        "uz": "Suv hech qachon yo‘qolmaydi.",
        "ru": "Вода никогда не исчезает.",
        "en": "Water never disappears."
      },
      {
        "who": "piku",
        "scene": "play",
        "uz": "Endi o‘yinda tomchiga yordam ber!",
        "ru": "Теперь помоги капельке в игре!",
        "en": "Now help the droplet in the game!"
      }
    ]
  },
  "crossing": {
    "voice": false,
    "title": {
      "uz": "Ko‘chani qanday kesib o‘tamiz?",
      "ru": "Как переходить улицу?",
      "en": "How do we cross the street?"
    },
    "parent": {
      "uz": "Yo‘ldan o‘tishni kattalar bilan birga mashq qiling: har safar «to‘xta, qara, tingla».",
      "ru": "Тренируйтесь переходить дорогу вместе со взрослым: каждый раз «стой, смотри, слушай».",
      "en": "Practise crossing together with a grown-up: every time, “stop, look, listen”."
    },
    "quiz": {
      "q": {
        "uz": "Qizil chiroq yonsa nima qilamiz?",
        "ru": "Что делаем, когда горит красный?",
        "en": "What do we do at a red light?"
      },
      "options": [
        {
          "pic": "✋",
          "uz": "to‘xtaymiz",
          "ok": true
        },
        {
          "pic": "🏃",
          "uz": "yuguramiz",
          "ok": false
        }
      ]
    },
    "lines": [
      {
        "who": "mini",
        "scene": "hook",
        "uz": "Piku, ko‘chadan xavfsiz qanday o‘tamiz?",
        "ru": "Пику, как безопасно перейти улицу?",
        "en": "Piku, how do we cross the street safely?",
        "visual": "street, a car drives past"
      },
      {
        "who": "piku",
        "scene": "rules",
        "uz": "Uch qoidani eslab qol: to‘xta, qara, tingla!",
        "ru": "Запомни три правила: стой, смотри, слушай!",
        "en": "Remember three rules: stop, look, listen!",
        "visual": "three icons pop: hand, eyes, ear"
      },
      {
        "who": "mini",
        "scene": "stop",
        "uz": "Birinchi qoida: yo‘l chetida to‘xta.",
        "ru": "Первое правило: остановись у края дороги.",
        "en": "Rule one: stop at the edge of the road.",
        "visual": "kerb, big stop hand"
      },
      {
        "who": "piku",
        "scene": "hold",
        "uz": "Yugurma. Kattaning qo‘lidan ushla.",
        "ru": "Не бегай. Держись за руку взрослого.",
        "en": "Do not run. Hold a grown-up’s hand.",
        "visual": "a hand to hold, a ball stays still"
      },
      {
        "who": "mini",
        "scene": "look",
        "uz": "Ikkinchi qoida: chapga, o‘ngga, yana chapga qara.",
        "ru": "Второе правило: посмотри налево, направо и снова налево.",
        "en": "Rule two: look left, right, then left again.",
        "visual": "eyes look left, then right"
      },
      {
        "who": "piku",
        "scene": "car",
        "uz": "Mashina kelyaptimi? Yaxshilab qara.",
        "ru": "Едет ли машина? Хорошенько посмотри.",
        "en": "Is a car coming? Look carefully.",
        "visual": "a car passes, then the road is clear"
      },
      {
        "who": "mini",
        "scene": "listen",
        "uz": "Uchinchi qoida: diqqat bilan tingla.",
        "ru": "Третье правило: внимательно слушай.",
        "en": "Rule three: listen carefully.",
        "visual": "big ear, sound waves"
      },
      {
        "who": "piku",
        "scene": "sound",
        "uz": "Mashina ovozi eshitilyaptimi?",
        "ru": "Слышен ли звук машины?",
        "en": "Can you hear a car?",
        "visual": "ear, a distant car"
      },
      {
        "who": "mini",
        "scene": "red",
        "uz": "Mana svetofor. Qizil odamcha — to‘xta!",
        "ru": "Вот светофор. Красный человечек — стой!",
        "en": "Here is the traffic light. Red figure — stop!",
        "visual": "traffic light turns red"
      },
      {
        "who": "piku",
        "scene": "green",
        "uz": "Yashil odamcha — o‘tish mumkin.",
        "ru": "Зелёный человечек — можно идти.",
        "en": "Green figure — you may cross.",
        "visual": "traffic light turns green"
      },
      {
        "who": "mini",
        "scene": "again",
        "uz": "Lekin avval yana chapga, o‘ngga, chapga qara.",
        "ru": "Но сначала снова посмотри налево, направо и налево.",
        "en": "But first look left, right and left again.",
        "visual": "eyes look both ways"
      },
      {
        "who": "piku",
        "scene": "zebra",
        "uz": "Zebra chiziqdan o‘tamiz. Shoshilmaymiz.",
        "ru": "Идём по зебре. Не спешим.",
        "en": "We cross on the zebra. No rushing.",
        "visual": "zebra crossing, calm walking"
      },
      {
        "who": "mini",
        "scene": "repeat",
        "uz": "To‘xta, qara, tingla — keyin yur!",
        "ru": "Стой, смотри, слушай — потом иди!",
        "en": "Stop, look, listen — then walk!",
        "visual": "the three icons again, then go"
      },
      {
        "who": "piku",
        "scene": "quiz",
        "uz": "Endi savol: qizil chiroqda nima qilamiz?",
        "ru": "Теперь вопрос: что делаем на красный?",
        "en": "Now a question: what do we do at red?",
        "visual": "red light, a question mark"
      }
    ]
  },
