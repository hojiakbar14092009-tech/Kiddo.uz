# Copy to .env.local and fill in to enable parent accounts and cloud sync.
# Without these values Kiddo runs fully offline and the parent area offers demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 56: the parents' Telegram bot's username (without @). Leave empty to hide Telegram.
# The bot's token and webhook secret live only in Supabase secrets (TELEGRAM_BOT_TOKEN,
# TELEGRAM_WEBHOOK_SECRET), never here.
VITE_TELEGRAM_BOT=

# MVP server (Vercel Function /api + Turso "kiddo"). Server-only: never VITE_-prefixed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# the bot's username without @; then run: node scripts/telegram-webhook.mjs https://<domain>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# random, A-Z a-z 0-9 _ - only (Telegram sends it back in X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# unset or anything but "test" refuses payments (503); "test" = free test payment, no provider yet
PAYMENT_MODE=
# the sender of sign-in e-mails, e.g. Kiddo <no-reply@your-domain>
# (SMTP_FROM is listed above with the other SMTP_* names)
# only if the site is also served from another origin (CSRF check); normally leave unset
APP_ORIGIN=
